--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -8613,6 +8613,107 @@
 }
 
 /*
+ * Per-LLC idle CPU bitmap.
+ *
+ * llc_idle_enter()/llc_idle_exit() run from the idle class with this
+ * CPU's rq lock held and publish one bit with cpumask_set_cpu()/
+ * cpumask_clear_cpu() (atomic set_bit/clear_bit). The wakeup path only
+ * tests bits and may clear a stale one. It does not take a lock.
+ */
+void llc_idle_enter(int cpu)
+{
+	struct sched_domain_shared *sds;
+
+	rcu_read_lock();
+	sds = rcu_dereference_all(per_cpu(sd_llc_shared, cpu));
+	if (sds && cpumask_available(sds->idle_cpus))
+		cpumask_set_cpu(cpu, sds->idle_cpus);
+	rcu_read_unlock();
+}
+
+void llc_idle_exit(int cpu)
+{
+	struct sched_domain_shared *sds;
+
+	rcu_read_lock();
+	sds = rcu_dereference_all(per_cpu(sd_llc_shared, cpu));
+	if (sds && cpumask_available(sds->idle_cpus))
+		cpumask_clear_cpu(cpu, sds->idle_cpus);
+	rcu_read_unlock();
+}
+
+/* Re-check one bitmap bit. Clear it when the CPU is no longer idle. */
+static int llc_idle_bitmap_cpu(struct task_struct *p, struct cpumask *idle,
+			       int cpu)
+{
+	if (!cpumask_test_cpu(cpu, p->cpus_ptr))
+		return -1;
+
+	if ((unsigned int)__select_idle_cpu(cpu, p) < nr_cpumask_bits)
+		return cpu;
+
+	/*
+	 * Affinity and core-cookie misses leave the bit set. A busy CPU
+	 * that is not a SCHED_IDLE runqueue is a stale bit.
+	 */
+	if (!available_idle_cpu(cpu) && !sched_idle_rq(cpu_rq(cpu)))
+		cpumask_clear_cpu(cpu, idle);
+
+	return -1;
+}
+
+/*
+ * First allowed idle CPU in @span, wrapping the same way the linear
+ * LLC walk does (start at target + 1). Only set bits are visited.
+ */
+static int llc_idle_bitmap_pick(struct task_struct *p, struct cpumask *idle,
+				const struct cpumask *span, int target)
+{
+	int cpu, idle_cpu;
+
+	for_each_cpu_wrap(cpu, idle, target + 1) {
+		if (!cpumask_test_cpu(cpu, span))
+			continue;
+
+		idle_cpu = llc_idle_bitmap_cpu(p, idle, cpu);
+		if ((unsigned int)idle_cpu < nr_cpumask_bits)
+			return idle_cpu;
+	}
+
+	return -1;
+}
+
+static int select_idle_cpu_bitmap(struct task_struct *p, struct sched_domain *sd,
+				  int target)
+{
+	struct cpumask *idle;
+	int cpu;
+
+	if (!sd->shared || !cpumask_available(sd->shared->idle_cpus))
+		return -1;
+
+	idle = sd->shared->idle_cpus;
+
+	/*
+	 * Cluster machines still prefer an idle CPU that shares the
+	 * target's lower cache. That used to be the first loop of the
+	 * linear walk; do it against the bitmap so a hit keeps it.
+	 */
+	if (static_branch_unlikely(&sched_cluster_active)) {
+		struct sched_group *sg = sd->groups;
+
+		if (sg->flags & SD_CLUSTER) {
+			cpu = llc_idle_bitmap_pick(p, idle,
+						   sched_group_span(sg), target);
+			if ((unsigned int)cpu < nr_cpumask_bits)
+				return cpu;
+		}
+	}
+
+	return llc_idle_bitmap_pick(p, idle, sched_domain_span(sd), target);
+}
+
+/*
  * Scan the LLC domain for idle CPUs; this is dynamically regulated by
  * comparing the average scan cost (tracked in sd->avg_scan_cost) against the
  * average idle time for this rq (as found in rq->avg_idle).
@@ -8636,6 +8737,24 @@
 		/* overloaded LLC is unlikely to have idle cpu/core */
 		if (nr == 1)
 			return -1;
+	}
+
+	/*
+	 * SMT idle-core search stays on the linear walk: the bitmap names
+	 * idle CPUs, not idle cores. Asym capacity returns before this
+	 * function; asym packing is left in load balance.
+	 */
+	if (!has_idle_core) {
+		i = select_idle_cpu_bitmap(p, sd, target);
+		if ((unsigned int)i < nr_cpumask_bits)
+			return i;
+
+		/*
+		 * Bitmap empty or stale (no allowed idle CPU left in it).
+		 * Fall back to the capped linear LLC walk below. That walk
+		 * still applies the SIS_UTIL scan limit and can place on a
+		 * SCHED_IDLE runqueue, which this bitmap does not track.
+		 */
 	}
 
 	if (!cpumask_and(cpus, sched_domain_span(sd), p->cpus_ptr))
@@ -8993,6 +9112,10 @@
 		}
 	}
 
+	/*
+	 * target, prev and recent_used_cpu already missed. select_idle_cpu()
+	 * consults the per-LLC idle bitmap before the capped linear walk.
+	 */
 	i = select_idle_cpu(p, sd, has_idle_core, target);
 	if ((unsigned)i < nr_cpumask_bits)
 		return i;
