+#ifdef CONFIG_CFS_BANDWIDTH
+/*
+ * Task-3 prototype helpers.
+ *
+ * Survey option (B): per-cgroup deadline servers for bandwidth-capped groups
+ * instead of relying solely on nested EEVDF + CFS period refill for the
+ * capped subtree's pick path.
+ *
+ * Scope (honest):
+ *  - Feature defaults OFF (sysctl kernel.sched_cgroup_dl_servers=0).
+ *  - When on, admit a per-CPU dl_server for bandwidth-root groups: the group
+ *    has cpu.max set and no ancestor below root also has quota. That covers
+ *    depth-1-under-root groups with cpu.max (survey wording) and deeper
+ *    first-capped leaves (Task 3 harness throttle groups).
+ *  - Server pick starts at that group's cfs_rq, not the root.
+ *  - CFS bandwidth period refill and throttling remain authoritative —
+ *    we do NOT bypass distribute_cfs_runtime. The DL server is an additional
+ *    pick path (fair_server-style) sized like the global fair_server so DL
+ *    bw admission stays realistic.
+ *  - Hierarchical cpu.weight among opted-in siblings is NOT rebuilt; weight
+ *    sharing may be wrong/ignored for the DL pick path. Prototype only.
+ */
+
+static bool cgroup_dl_server_is_bw_root(struct task_group *tg)
+{
+	struct task_group *p;
+
+	if (!tg || is_root_task_group(tg))
+		return false;
+	if (tg->cfs_bandwidth.quota == RUNTIME_INF)
+		return false;
+
+	for (p = tg->parent; p && !is_root_task_group(p); p = p->parent) {
+		if (p->cfs_bandwidth.quota != RUNTIME_INF)
+			return false;
+	}
+	return true;
+}
+
+static struct task_struct *
+cgroup_dl_server_pick_task(struct sched_dl_entity *dl_se, struct rq_flags *rf)
+	__must_hold(__rq_lockp(dl_se->rq))
+{
+	struct cgroup_dl_server *cs =
+		container_of(dl_se, struct cgroup_dl_server, dl_se);
+	struct rq *rq = dl_se->rq;
+	struct cfs_rq *cfs_rq;
+
+	if (!cs->tg)
+		return NULL;
+
+	cfs_rq = tg_cfs_rq(cs->tg, cpu_of(rq));
+	if (!cfs_rq)
+		return NULL;
+
+	return pick_task_fair_from(rq, cfs_rq, rf, false);
+}
+
+static void cgroup_dl_server_init_cpu(struct cgroup_dl_server *cs,
+				     struct task_group *tg, struct rq *rq)
+{
+	struct sched_dl_entity *dl_se = &cs->dl_se;
+	u64 runtime = 50 * NSEC_PER_MSEC;
+	u64 period = 1000 * NSEC_PER_MSEC;
+
+	memset(cs, 0, sizeof(*cs));
+	cs->tg = tg;
+	init_dl_entity(dl_se);
+	dl_server_init(dl_se, rq, cgroup_dl_server_pick_task);
+
+	/*
+	 * Match fair_server defaults. Apply may fail if DL bw is exhausted;
+	 * in that case leave this CPU without an active server (dl_runtime 0
+	 * / not attached) rather than breaking CFS bandwidth.
+	 */
+	if (dl_server_apply_params(dl_se, runtime, period, 1)) {
+		cs->tg = tg; /* keep cookie for debugging */
+		dl_se->dl_runtime = 0;
+		return;
+	}
+
+	dl_se->dl_server = 1;
+	dl_se->dl_defer = 1;
+	/* setup_new_dl_entity is deadline.c-local; first dl_server_start replenishes. */
+}
+
+void sched_cgroup_dl_server_detach(struct task_group *tg)
+{
+	struct cgroup_dl_server __percpu *servers;
+	int cpu;
+
+	if (!tg)
+		return;
+
+	servers = tg->cg_dl_server;
+	if (!servers)
+		return;
+
+	for_each_possible_cpu(cpu) {
+		struct cgroup_dl_server *cs = per_cpu_ptr(servers, cpu);
+		struct rq *rq = cpu_rq(cpu);
+		struct rq_flags rf;
+
+		rq_lock_irq(rq, &rf);
+		if (dl_server_active(&cs->dl_se))
+			dl_server_stop(&cs->dl_se);
+		if (cs->dl_se.dl_bw_attached)
+			dl_server_detach_bw(&cs->dl_se);
+		cs->dl_se.dl_server = 0;
+		cs->dl_se.dl_runtime = 0;
+		cs->tg = NULL;
+		rq_unlock_irq(rq, &rf);
+	}
+
+	free_percpu(servers);
+	tg->cg_dl_server = NULL;
+}
+
+static int cgroup_dl_server_admit(struct task_group *tg)
+{
+	struct cgroup_dl_server __percpu *servers;
+	int cpu;
+
+	if (tg->cg_dl_server)
+		return 0;
+
+	servers = alloc_percpu(struct cgroup_dl_server);
+	if (!servers)
+		return -ENOMEM;
+
+	for_each_possible_cpu(cpu) {
+		struct cgroup_dl_server *cs = per_cpu_ptr(servers, cpu);
+		struct rq *rq = cpu_rq(cpu);
+		struct rq_flags rf;
+
+		rq_lock_irq(rq, &rf);
+		update_rq_clock(rq);
+		cgroup_dl_server_init_cpu(cs, tg, rq);
+		rq_unlock_irq(rq, &rf);
+	}
+
+	/*
+	 * Publish after init so enqueue hints never observe a half-built
+	 * percpu array. Pairs with READ on the enqueue hint path.
+	 */
+	WRITE_ONCE(tg->cg_dl_server, servers);
+	return 0;
+}
+
+void sched_cgroup_dl_server_bandwidth_changed(struct task_group *tg,
+					     bool runtime_enabled)
+{
+	if (!static_branch_unlikely(&sched_cgroup_dl_servers_key)) {
+		/* Feature off: ensure no leftover servers from a prior enable. */
+		if (tg->cg_dl_server)
+			sched_cgroup_dl_server_detach(tg);
+		return;
+	}
+
+	if (runtime_enabled && cgroup_dl_server_is_bw_root(tg))
+		cgroup_dl_server_admit(tg);
+	else if (tg->cg_dl_server)
+		sched_cgroup_dl_server_detach(tg);
+}
+
+static void cgroup_dl_server_enqueue_hint(struct rq *rq, struct task_struct *p)
+{
+	struct task_group *tg;
+	struct cgroup_dl_server __percpu *servers;
+	struct cgroup_dl_server *cs;
+
+	if (!static_branch_unlikely(&sched_cgroup_dl_servers_key))
+		return;
+
+	tg = task_group(p);
+	while (tg && !is_root_task_group(tg)) {
+		servers = READ_ONCE(tg->cg_dl_server);
+		if (servers) {
+			cs = per_cpu_ptr(servers, cpu_of(rq));
+			if (cs->dl_se.dl_server && cs->dl_se.dl_runtime)
+				dl_server_start(&cs->dl_se);
+			return;
+		}
+		tg = tg->parent;
+	}
+}
+#endif /* CONFIG_CFS_BANDWIDTH */
+
 /*
  * Account for a descheduled task:
  */
@@ -15193,6 +15449,9 @@
 
 void free_fair_sched_group(struct task_group *tg)
 {
+#ifdef CONFIG_CFS_BANDWIDTH
+	sched_cgroup_dl_server_detach(tg);
+#endif
 	free_percpu(tg->cfs_rq);
 }
 
