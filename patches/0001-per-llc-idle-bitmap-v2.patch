 /*
+ * Per-LLC idle CPU bitmap.
+ *
+ * The bitmap is a hint, not an exact idle set. A set bit means "this CPU
+ * entered the idle class and no waker has seen it busy since". It is NOT
+ * cleared when the CPU leaves idle (lazy clearing), and every writer
+ * tests the bit first so the shared cache line is only written when the
+ * bit value actually changes:
+ *
+ *  - llc_idle_enter() runs from set_next_task_idle() with this CPU's rq
+ *    lock held and sets the bit only if it is clear. A CPU bouncing in
+ *    and out of idle while its bit is still set does no shared write.
+ *  - select_idle_cpu_bitmap() rechecks every candidate with
+ *    __select_idle_cpu() and clears a bit it finds stale (CPU busy and
+ *    not a SCHED_IDLE runqueue), again only if the bit is still set.
+ *  - llc_idle_clear() drops the bit on hotplug deactivate.
+ *
+ * A lost bit (a waker clears it just as the CPU re-enters idle) only
+ * costs the hint: the capped linear walk still finds that CPU, and its
+ * next idle entry sets the bit again.
+ */
+static inline struct cpumask *llc_idle_mask(int cpu)
+{
+	struct sched_domain_shared *sds;
+
+	sds = rcu_dereference_all(per_cpu(sd_llc_shared, cpu));
+	if (sds && cpumask_available(sds->idle_cpus))
+		return sds->idle_cpus;
+	return NULL;
+}
+
+void llc_idle_enter(int cpu)
+{
+	struct cpumask *idle;
+
+	/* A deactivated (going offline) CPU must not re-publish itself. */
+	if (!cpu_active(cpu))
+		return;
+
+	rcu_read_lock();
+	idle = llc_idle_mask(cpu);
+	if (idle && !cpumask_test_cpu(cpu, idle))
+		cpumask_set_cpu(cpu, idle);
+	rcu_read_unlock();
+}
+
+void llc_idle_clear(int cpu)
+{
+	struct cpumask *idle;
+
+	rcu_read_lock();
+	idle = llc_idle_mask(cpu);
+	if (idle && cpumask_test_cpu(cpu, idle))
+		cpumask_clear_cpu(cpu, idle);
+	rcu_read_unlock();
+}
+
+/*
+ * Re-check one candidate taken from the bitmap. @cpu is already known to
+ * be in the LLC span and in p->cpus_ptr. Clear the live bit when the CPU
+ * is no longer idle; core-cookie misses on an idle CPU keep the bit.
+ */
+static int llc_idle_bitmap_cpu(struct task_struct *p, struct cpumask *idle,
+			       int cpu)
+{
+	if ((unsigned int)__select_idle_cpu(cpu, p) < nr_cpumask_bits)
+		return cpu;
+
+	if (!available_idle_cpu(cpu) && !sched_idle_rq(cpu_rq(cpu)) &&
+	    cpumask_test_cpu(cpu, idle))
+		cpumask_clear_cpu(cpu, idle);
+
+	return -1;
+}
+
+/*
+ * Pick an idle CPU from the per-LLC bitmap. @cpus is the caller's scratch
+ * mask (select_rq_mask); it is overwritten here.
+ *
+ * Candidates are snapshotted once as LLC span & p->cpus_ptr & idle_cpus,
+ * so the shared bitmap line is read once and the iteration below cannot
+ * be disturbed by concurrent set/clear. The walk wraps starting at
+ * @target, so wakeups spread out from the waker's/wakee's own position
+ * instead of piling onto the lowest-numbered idle CPUs. As in the linear
+ * walk, CPUs sharing @target's cluster are tried first.
+ */
+static int select_idle_cpu_bitmap(struct task_struct *p, struct sched_domain *sd,
+				  struct cpumask *cpus, int target)
+{
+	struct cpumask *idle;
+	int cpu;
+
+	if (!sd->shared || !cpumask_available(sd->shared->idle_cpus))
+		return -1;
+
+	idle = sd->shared->idle_cpus;
+
+	if (!cpumask_and(cpus, sched_domain_span(sd), p->cpus_ptr))
+		return -1;
+	if (!cpumask_and(cpus, cpus, idle))
+		return -1;
+
+	if (static_branch_unlikely(&sched_cluster_active)) {
+		struct sched_group *sg = sd->groups;
+
+		if (sg->flags & SD_CLUSTER) {
+			for_each_cpu_wrap(cpu, sched_group_span(sg), target) {
+				if (!cpumask_test_cpu(cpu, cpus))
+					continue;
+
+				if ((unsigned int)llc_idle_bitmap_cpu(p, idle, cpu) <
+				    nr_cpumask_bits)
+					return cpu;
+			}
+			cpumask_andnot(cpus, cpus, sched_group_span(sg));
+		}
+	}
+
+	for_each_cpu_wrap(cpu, cpus, target) {
+		if ((unsigned int)llc_idle_bitmap_cpu(p, idle, cpu) < nr_cpumask_bits)
+			return cpu;
+	}
+
+	return -1;
+}
+
+/*
  * Scan the LLC domain for idle CPUs; this is dynamically regulated by
  * comparing the average scan cost (tracked in sd->avg_scan_cost) against the
  * average idle time for this rq (as found in rq->avg_idle).
@@ -8638,6 +8764,25 @@
 			return -1;
 	}
 
+	/*
+	 * SMT idle-core search stays on the linear walk: the bitmap names
+	 * idle CPUs, not idle cores. Asym capacity returns before this
+	 * function; asym packing is left in load balance.
+	 */
+	if (!has_idle_core) {
+		i = select_idle_cpu_bitmap(p, sd, cpus, target);
+		if ((unsigned int)i < nr_cpumask_bits)
+			return i;
+
+		/*
+		 * Bitmap empty or stale (no allowed idle CPU left in it).
+		 * Fall back to the capped linear LLC walk below. That walk
+		 * still applies the SIS_UTIL scan limit and can place on a
+		 * SCHED_IDLE runqueue, which this bitmap does not track.
+		 * @cpus was used as scratch above and is rebuilt here.
+		 */
+	}
+
 	if (!cpumask_and(cpus, sched_domain_span(sd), p->cpus_ptr))
 		return -1;
 
